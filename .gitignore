# 先忽略所有
*

# 保留 gitignore 自己
!.gitignore

# 保留主目录下的 change.md
!/change.md

# 保留 README 及其中文备份
!/README.md
!/README_zh-CN.md

# 保留 README 使用的截图
!/web照片/
!/web照片/**

# 保留 web 文件夹及其全部内容
!/web/
!/web/**

# 保留 8 个算法项目的 setup_env.sh
!/AtomGS-main/
!/AtomGS-main/setup_env.sh
!/CompGS-main/
!/CompGS-main/setup_env.sh
!/ContextGS-main/
!/ContextGS-main/setup_env.sh
!/gaussian-splatting-lightning-main/
!/gaussian-splatting-lightning-main/setup_env.sh
!/GaussianPro-version1.0/
!/GaussianPro-version1.0/setup_env.sh
!/HAC-plus-main/
!/HAC-plus-main/setup_env.sh
!/MEGS-2-main/
!/MEGS-2-main/setup_env.sh
!/reduced-3dgs-main/
!/reduced-3dgs-main/setup_env.sh

# 忽略 web 里的数据、缓存、日志和备份
/web/_backup/
/web/generated/
/web/test1/
/web/**/__pycache__/
/web/**/*.py[co]
/web/**/*.log
/web/**/*.csv
/web/**/*.png
/web/**/*.jpg
/web/**/*.jpeg
/web/**/*.webp
/web/**/*.gif
/web/**/*.bmp
/web/**/*.ply
/web/**/*.bin
/web/**/*.db
/web/**/*.sqlite
/web/**/*.sqlite3
/web/**/*.tmp
/web/**/*.bak
/web/**/*.DS_Store
